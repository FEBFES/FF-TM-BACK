# syntax=docker/dockerfile:1

ARG SERVICE_DIR
ARG EXPOSE_PORT
ARG EXTRA_PACKAGES=""
ARG PRE_BUILD_CMD=""

FROM eclipse-temurin:17-jdk-jammy AS build
ARG SERVICE_DIR
ARG EXTRA_PACKAGES
ARG PRE_BUILD_CMD

WORKDIR /home/${SERVICE_DIR}

# Copy service sources
COPY ./${SERVICE_DIR}/ ./
# Copy shared modules
COPY ./febfes-commons ./febfes-commons
COPY ./ff-tm-grpc-api ./ff-tm-grpc-api

# Optional packages and custom commands before build
RUN set -eux; \
        if [ -n "$EXTRA_PACKAGES" ]; then \
          apt-get update && apt-get install -y --no-install-recommends $EXTRA_PACKAGES && rm -rf /var/lib/apt/lists/*; \
        fi; \
    chmod +x mvnw && \
    sed -i 's/\r$//' mvnw && \
    /bin/sh -c "$PRE_BUILD_CMD" && \
    ./mvnw -f febfes-commons/pom.xml clean install -DskipTests && \
    ./mvnw -f ff-tm-grpc-api/pom.xml clean install -DskipTests && \
    ./mvnw clean install -Dmaven.test.skip

FROM eclipse-temurin:17-jdk-jammy
ARG SERVICE_DIR
ARG EXPOSE_PORT

WORKDIR /home/${SERVICE_DIR}
COPY --from=build /home/${SERVICE_DIR}/target/*.jar app.jar
EXPOSE ${EXPOSE_PORT}
ENTRYPOINT ["java", "-jar", "app.jar"]
